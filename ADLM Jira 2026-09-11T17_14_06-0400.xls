                <tr id="issuerow9770410" rel="9770410" data-issuekey="CR-38684" class="issuerow">
                                            <td class="project">    NIQ Activate
</td>
                                            <td class="issuekey">

    <a class="issue-link" data-issue-key="CR-38684" href="https://adlm.nielseniq.com/jira/browse/CR-38684">CR-38684</a>
</td>
                                            <td class="summary"><p>
                Unlimitail: User‑Controlled Lookback Periods 
    </p>
</td>
                                            <td class="issuetype">    Epic
</td>
                                            <td class="status">
                <span class=" jira-issue-status-lozenge aui-lozenge jira-issue-status-lozenge-inprogress jira-issue-status-lozenge-indeterminate aui-lozenge-subtle jira-issue-status-lozenge-max-width-medium" data-tooltip="&lt;span class=&quot;jira-issue-status-tooltip-title&quot;&gt;In Review&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;jira-issue-status-tooltip-desc&quot;&gt;In Review&lt;/span&gt;" title="&lt;span class=&quot;jira-issue-status-tooltip-title&quot;&gt;In Review&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;jira-issue-status-tooltip-desc&quot;&gt;In Review&lt;/span&gt;" tabindex="0">In Review</span>    </td>
                                            <td class="priority">           High
    </td>
                                            <td class="resolution">    <em>Unresolved</em>
</td>
                                            <td class="assignee">    <em>Unassigned</em>
</td>
